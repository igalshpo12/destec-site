# Supabase (public — safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://likaubaiqrojlwqzoepp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_gIlCUf4i2Ne9VznqP4g8Vw_nZqZqx00

# Contact form — recipient address
CONTACT_EMAIL=info@destec.co.il

# Resend — add key when ready; contact API falls back to console.log without it
RESEND_API_KEY=

# Analytics (public) — leave blank to disable. When either is set, the cookie
# consent banner appears and tags load only after the visitor opts in.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-side Lead event). META_PIXEL_ID falls back to
# NEXT_PUBLIC_META_PIXEL_ID; the token is required to send server-side events.
META_PIXEL_ID=
META_CAPI_TOKEN=

# Online payment — Credit2000 (D.C.S) hosted page, terminal 5432336 (same as des-manager).
# ALL FOUR must be set (plus SUPABASE_SERVICE_ROLE_KEY) or checkout keeps the e-mail-only flow.
CREDIT2000_VENDOR=
CREDIT2000_CLIENT_KEY=
# where Credit2000 sends the payer back — the deployment that runs this code (Vercel), not Konimbo
SITE_URL=https://destec-site.vercel.app
# SUPABASE_SERVICE_ROLE_KEY=   (server-only: web_orders is RLS with no policies)
